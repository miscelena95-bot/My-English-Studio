# ---------------------------------------------------------------
# My English Studio — configuration
# Copy this file to .env.local and fill in what you need.
# Everything is optional: without an AI key the app still works
# (exercises, reviews, grammar, mistake tracker, progress), and
# AI-only features explain clearly that they are not configured.
# ---------------------------------------------------------------

# --- Database ---
# Local development: a SQLite file, created and migrated automatically.
DATABASE_PATH=./data/studio.db
# Hosted (required on Vercel): a Turso / libSQL database. When DATABASE_URL is
# set it takes precedence over DATABASE_PATH.
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# --- AI provider (server-side only; never exposed to the browser) ---
# Supported: anthropic (paid) and gemini (has a free tier). If AI_PROVIDER is
# empty, the app uses whichever key is set (Anthropic first).
AI_PROVIDER=
# Anthropic Claude — https://console.anthropic.com/ (paid usage)
ANTHROPIC_API_KEY=
# Google Gemini — https://aistudio.google.com/api-keys (free tier: about
# 20 requests per model per day; free-tier data may be used by Google)
GEMINI_API_KEY=
# Optional model override. Defaults: claude-opus-5-5 / gemini-3.8-flash
# AI_MODEL=
# Gemini only: second model, used when the first one's daily quota runs out.
# Default gemini-3.6-flash; "none" disables it.
# AI_FALLBACK_MODEL=gemini-3.6-flash
# Gemini only: free requests per model per day, for the usage meter. Default 20.
# AI_DAILY_LIMIT=20

# --- News (optional) ---
# Free developer key from https://open-platform.theguardian.com/access/
# Enables recent articles in Real English > News. Without it, the app
# uses prepared evergreen activities instead (it never invents news).
GUARDIAN_API_KEY=

# --- Access protection (recommended if you deploy publicly) ---
# If set, the whole app asks for this passcode (HTTP Basic auth, any username).
# On Vercel it is REQUIRED: without it the deployment stays locked, unless you
# set STUDIO_PUBLIC=1 to make it public deliberately.
STUDIO_PASSCODE=
